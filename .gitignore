# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/scratchpad/

# local preview process files
/tmp-*.log
/tmp-*.pid

# Local Python env for scripts/generate_static_korean_audio.py
.venv-tts/
__pycache__/
*.py[cod]

# Local-only secrets for previewing signed-in pages. Never deployed.
.dev.vars
.dev.vars.*

# Empty accidental shell artifact (not application source).
/tr(l
